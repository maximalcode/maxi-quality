# What the formatter is NOT allowed to touch, and why.
#
# Each entry is a reason, not a convenience. An ignore file that grows by
# "prettier complained about this" is how a format gate stops covering anything.

node_modules/

# THE SEMGREP FIXTURES ARE LINE-NUMBERED ASSERTIONS.
#
# samples/expected/semgrep.json pins every finding as (rule id, file, LINE).
# Prettier rewraps two of these files, which moves those lines — so formatting
# them means regenerating the manifest in the same commit, and a manifest
# regenerated alongside the change it was supposed to catch asserts nothing.
# The layout of a Semgrep fixture is part of the fixture.
samples/semgrep/

# DELIBERATELY MISFORMATTED. These files exist to prove the format gate fails
# when it should; formatting them would delete the test.
samples/format/

# Generated by tools, owned by the tools.
package-lock.json
