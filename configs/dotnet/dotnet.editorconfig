# maxi-quality — C# analyzer severities and style.
#
# USAGE: append this to the consuming repo's .editorconfig (which starts life as
# a copy of configs/editorconfig):
#
#   cat ~/dev/mine/maxi-quality/configs/dotnet/dotnet.editorconfig >> <repo>/.editorconfig
#
# Deliberately minimal. Bug-finding lives in the analyzers (Roslyn CA*, Sonar S*,
# Roslynator RCS*) configured by Directory.Build.props — not in style rules.
# What follows is the small set of style rules worth failing a build over, plus
# severity corrections where the defaults are wrong for how I work.

[*.cs]

# --- Style rules promoted to errors (via EnforceCodeStyleInBuild) ------------
# Dead code is a bug that hasn't happened yet.
dotnet_diagnostic.IDE0051.severity = error   # unused private member
dotnet_diagnostic.IDE0052.severity = error   # unread private member
dotnet_diagnostic.IDE0005.severity = error   # unnecessary using directive

# Correctness-adjacent style.
dotnet_diagnostic.IDE0035.severity = error   # unreachable code
dotnet_diagnostic.IDE0059.severity = error   # unnecessary value assignment
dotnet_diagnostic.IDE0060.severity = error   # unused parameter

# --- Severity corrections ---------------------------------------------------
# ConfigureAwait(false) matters in libraries, is noise in apps/tests. Opt in
# per-repo rather than paying for it everywhere.
dotnet_diagnostic.CA2007.severity = none
# I do not ship XML docs for internal code.
dotnet_diagnostic.CS1591.severity = none
# Sonar's "remove commented-out code" is right but too eager on TODO blocks.
dotnet_diagnostic.S125.severity = suggestion
# A TODO that points at a tracked issue must not fail the build — same shape as
# the S125 demotion above. Suggestion keeps it visible in the IDE.
dotnet_diagnostic.S1135.severity = suggestion
# Roslynator wants the four-constructor exception boilerplate. Measured on
# Consumer A (#56): 55 hits, every one a small sealed domain exception whose
# single constructor is the point. The serialization ctor died with .NET 5.
dotnet_diagnostic.RCS1194.severity = none
# LoggerMessage source-gen is hot-path library machinery. For an app whose
# logging cost is dwarfed by the I/O it logs about, rewriting every log site
# (38 on Consumer A) is churn, not quality. Opt in per-repo where it matters.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# --- Style preferences (autofixable by `dotnet format`) ---------------------
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:error
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion

dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_predefined_type_for_locals_parameters_members = true:error

csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

# --- Naming: the rules that actually get violated ----------------------------
# THIS LINE IS WHAT MAKES EVERY NAMING RULE BELOW DO ANYTHING (#8). Measured
# 2026-08-03: without it, every naming violation built cleanly — a probe with an
# un-prefixed interface, a snake_case class and a PascalCase private field
# produced ZERO IDE1006. `dotnet_naming_rule.<rule>.severity` governs the IDE
# experience; build enforcement reads the diagnostic's own severity, and that
# was never set. The rules were not "inert because no sample violates them",
# which is how this looked from the outside — they were switched off.
#
# Two of the three were masked by analyzers that happen to overlap (CA1715 on
# the interface prefix, CA1707/S101 on the type name), so the gap only showed
# up on the third: a private field named `Count` was caught by NOTHING.
dotnet_diagnostic.IDE1006.severity = error   # naming rule violation

dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_pascal
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_pascal.required_prefix = I
dotnet_naming_style.prefix_i_pascal.capitalization = pascal_case

dotnet_naming_rule.types_are_pascal_case.severity = error
dotnet_naming_rule.types_are_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_are_pascal_case.style = pascal
dotnet_naming_symbols.type_symbols.applicable_kinds = class,struct,enum,delegate
dotnet_naming_style.pascal.capitalization = pascal_case

# Const and static-readonly private fields are PascalCase by .NET convention,
# so the underscore rule below must not catch them. Measured on Consumer A
# (#56): 13 hits in production code, all const/static-readonly, zero genuine.
# These two rules are BOTH more specific (required_modifiers) and listed first
# — either property alone makes them win, so the two orderings cannot disagree.
dotnet_naming_rule.private_const_fields_are_pascal.severity = error
dotnet_naming_rule.private_const_fields_are_pascal.symbols = private_const_field_symbols
dotnet_naming_rule.private_const_fields_are_pascal.style = pascal
dotnet_naming_symbols.private_const_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_const_field_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_const_field_symbols.required_modifiers = const

dotnet_naming_rule.private_static_readonly_fields_are_pascal.severity = error
dotnet_naming_rule.private_static_readonly_fields_are_pascal.symbols = private_static_readonly_field_symbols
dotnet_naming_rule.private_static_readonly_fields_are_pascal.style = pascal
dotnet_naming_symbols.private_static_readonly_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_field_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_field_symbols.required_modifiers = static, readonly

dotnet_naming_rule.private_fields_are_camel_underscore.severity = error
dotnet_naming_rule.private_fields_are_camel_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_are_camel_underscore.style = underscore_camel
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# --- Generated code is not ours to lint ------------------------------------
[*.{Designer.cs,generated.cs,g.cs,g.i.cs}]
generated_code = true

# --- EF Core migration scaffolds -------------------------------------------
# EF names only the model-snapshot half of the pair `*.Designer.cs`; the scaffold
# itself is a plain `Migrations/<timestamp>_Name.cs`, so the section above misses
# it. Measured cost of that miss on Consumer A: 41 of 197 diagnostics, all
# IDE0161/IDE0005, all of them errors — enough to fail the data-access project
# and make MSBuild skip the eight downstream ones.
#
# NOT `generated_code = true`. That would disable every analyzer here, and a
# migration is the one piece of "generated" code people do hand-edit — custom
# SQL in Up() is routine. Style rules are switched off; CA*/S*/RCS* keep
# running, so raw SQL in a migration is still analysed.
# The brace form is load-bearing: a bare `**/Migrations/*.cs` requires at least
# one leading path segment, so it matches `src/<project>/Migrations/x.cs` but NOT a
# `Migrations/` folder sitting next to the .editorconfig. Cover both.
[{Migrations,**/Migrations}/*.cs]
dotnet_analyzer_diagnostic.category-Style.severity = none
# Category severity does not override an explicit per-id severity, so the ids
# escalated in [*.cs] above have to be named individually.
dotnet_diagnostic.IDE0005.severity = none   # unnecessary using
dotnet_diagnostic.IDE0051.severity = none   # unused private member
dotnet_diagnostic.IDE0052.severity = none   # unread private member
dotnet_diagnostic.IDE0035.severity = none   # unreachable code
dotnet_diagnostic.IDE0059.severity = none   # unnecessary value assignment
dotnet_diagnostic.IDE0060.severity = none   # unused parameter
dotnet_diagnostic.IDE0161.severity = none   # file-scoped namespace
# Not only style ids: these two are PERFORMANCE rules, so the category-Style
# line above never touched them. Measured on Consumer A (#56): 28× CA1861 +
# 2× CA1859, every one inside an EF scaffold. A migration's Up() runs once per
# database, and hand-fixing puts every FUTURE `dotnet ef migrations add` in
# violation the moment it is generated — the fix would be a standing tax on
# scaffolded code. CA*/S*/RCS* correctness rules keep running here.
dotnet_diagnostic.CA1861.severity = none   # constant array as argument
dotnet_diagnostic.CA1859.severity = none   # prefer concrete types

# --- Test code: naming enforcement fights fixture idiom ----------------------
# The same category as the test-project NoWarn list in Directory.Build.props,
# but path-scoped because .editorconfig cannot see the project name. Measured
# on Consumer A (#56): 333 IDE1006 hits in test fixtures, every one a
# `private readonly` fixture field without the underscore prefix.
#
# The DIAGNOSTIC is disabled, not the naming rules — build enforcement reads
# IDE1006 itself (see the naming section above, #8), so severity on the rules
# would change nothing. Cost accepted knowingly: this also stops IDE1006 on
# type/interface names in tests, where S101 still covers the type cases.
# The brace form covers both a root-level tests/ folder and a nested one, for
# the reason documented at the Migrations section.
[{tests,**/tests}/**.cs]
dotnet_diagnostic.IDE1006.severity = none
