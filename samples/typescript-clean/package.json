{
  "name": "@maximalcode/sample-typescript-clean",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deliberately CLEAN TypeScript. `npm run lint` MUST pass with zero findings \u2014 that is the test.",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
