<?xml version="1.0" encoding="utf-8"?>
<!--
  A coverlet-shaped Cobertura report: 40 lines valid, 30 covered = 75.00%.

  Note the two <class> entries for the SAME filename. That is what coverlet
  emits for a file holding two types, and it is why scripts/coverage.py trusts
  the root lines-valid/lines-covered attributes instead of counting <line>
  elements — counting them here would report a different, inflated total.
-->
<coverage line-rate="0.75" branch-rate="0.5" version="1.9" timestamp="0"
          lines-covered="30" lines-valid="40" branches-covered="5" branches-valid="10">
  <sources>
    <source>/src</source>
  </sources>
  <packages>
    <package name="Demo" line-rate="0.75" branch-rate="0.5" complexity="1">
      <classes>
        <class name="Demo.Widget" filename="Widget.cs" line-rate="0.8" branch-rate="0.5" complexity="1">
          <lines>
            <line number="1" hits="4" branch="false" />
            <line number="2" hits="4" branch="false" />
            <line number="3" hits="1" branch="false" />
            <line number="4" hits="0" branch="false" />
          </lines>
        </class>
        <class name="Demo.WidgetOptions" filename="Widget.cs" line-rate="0.5" branch-rate="0.5" complexity="1">
          <lines>
            <line number="6" hits="2" branch="false" />
            <line number="7" hits="0" branch="false" />
          </lines>
        </class>
      </classes>
    </package>
  </packages>
</coverage>
