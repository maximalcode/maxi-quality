<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately CLEAN C#. `dotnet build` MUST SUCCEED with 0 errors and 0
    warnings — that is the test. This is the negative control for
    configs/dotnet: a config that flags everything is as useless as one that
    flags nothing.

    The project name deliberately does NOT end in "Tests", so the test-project
    relaxation (#25) does not apply here. This file is held to the full,
    unrelaxed baseline.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Maximalcode.Sample.Clean</RootNamespace>
  </PropertyGroup>

</Project>
