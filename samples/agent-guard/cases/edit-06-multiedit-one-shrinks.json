{
  "why": "A batch is judged on its net effect. One shrinking edit hidden among additions is the obvious way past a per-edit check.",
  "hook": "sample",
  "setup": {
    "committed": {
      "samples/typescript/src/bad.ts": "export function f(a: any) {\n  if (a == 1) {\n    return a;\n  }\n  return null;\n}\n",
      "samples/expected/eslint.json": "{\n  \"tool\": \"eslint\",\n  \"findings\": [\n    {\n      \"rule\": \"eqeqeq\",\n      \"file\": \"samples/typescript/src/bad.ts\",\n      \"line\": 2\n    },\n    {\n      \"rule\": \"@typescript-eslint/no-explicit-any\",\n      \"file\": \"samples/typescript/src/bad.ts\",\n      \"line\": 1\n    }\n  ]\n}\n",
      "src/app.ts": "const x = 1;\nconst y = 2;\nconst z = 3;\n",
      "samples/typescript-clean/src/ok.ts": "export const ok = 1;\n"
    }
  },
  "event": {
    "hook_event_name": "PreToolUse",
    "tool_name": "MultiEdit",
    "tool_input": {
      "file_path": "{{ROOT}}/samples/typescript/src/bad.ts",
      "edits": [
        {
          "old_string": "  return null;\n",
          "new_string": "  const b: any = a;\n  return null;\n"
        },
        {
          "old_string": "  if (a == 1) {\n    return a;\n  }\n",
          "new_string": ""
        }
      ]
    }
  },
  "expect": {
    "decision": "deny",
    "reason_contains": [
      "test suite"
    ]
  }
}
