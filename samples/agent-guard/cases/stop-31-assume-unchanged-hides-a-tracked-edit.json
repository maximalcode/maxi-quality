{
  "why": "#217: index flags hide tracked edits from status. A real recorded gate must cover flagged paths and detect subsequent content drift.",
  "hook": "stop",
  "setup": {
    "committed": {
      "a.txt": "one\n"
    },
    "index_flags": {
      "assume-unchanged": [
        "a.txt"
      ]
    },
    "record": {
      "command": [
        "true"
      ],
      "after": {
        "a.txt": "TAMPERED\n"
      }
    }
  },
  "event": {
    "hook_event_name": "Stop"
  },
  "expect": {
    "decision": "block",
    "record_exit": 0,
    "reason_contains": [
      "changed since"
    ]
  }
}
