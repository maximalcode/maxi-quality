{
  "why": "#219: Git may warn and return no paths for an unreadable real nested repository; Stop must not call that clean.",
  "hook": "stop",
  "setup": {
    "committed": {
      "a.txt": "one\n",
      ".gitignore": ""
    },
    "worktree": {
      "nested/a.txt": "before\n"
    },
    "embedded_repos": [
      "nested"
    ],
    "record": {
      "command": [
        "true"
      ],
      "after": {
        "nested/a.txt": "after\n"
      }
    },
    "unreadable_repos": [
      "nested"
    ]
  },
  "event": {
    "hook_event_name": "Stop"
  },
  "expect": {
    "decision": "block",
    "record_exit": 0,
    "reason_contains": [
      "Cannot verify",
      "errors or warnings"
    ],
    "ledger": [
      "inspection-failed"
    ]
  }
}
